# Copiá este archivo a .env y agregá SOLO tu clave real allí.
# .env está excluido de Git.

# Proveedores: groq | openai | anthropic | ollama | openai_compatible
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Opcional: dejar vacío para usar la URL oficial del proveedor.
# Groq (por defecto): https://api.groq.com/openai/v1
# Ollama (ejemplo): http://localhost:11434
LLM_BASE_URL=

# json_schema (Groq, OpenAI y Ollama) o function_calling (alternativa compatible).
# Si se deja vacío, se elige el método predeterminado del proveedor.
LLM_STRUCTURED_METHOD=
# Solo se usa con Groq + json_schema; strict=true exige un esquema compatible.
LLM_STRICT=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Agregá ÚNICAMENTE la clave del proveedor que uses.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Usada solo con LLM_PROVIDER=openai_compatible
LLM_API_KEY=
